# cp .env.example .env 후 값 수정 (.env 는 커밋되지 않음)

# 로컬 이미지 이름 접두사 → cdi/postgres:16
IMAGE_PREFIX=cdi

# 모든 DB에 공통으로 쓰는 계정 (run.sh 가 DB별 환경변수 이름으로 변환)
DB_USER=app
DB_NAME=app
DB_PASSWORD=change-me

# 스키마 디렉터리 (databases/<db>/ 기준 상대경로)
SCHEMA_DIR=schema

# AWS (push-ecr.sh)
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=
ECR_PREFIX=cdi
# 멀티 아키텍처: Graviton(arm64) Fargate 와 x86 둘 다
PLATFORMS=linux/amd64,linux/arm64
