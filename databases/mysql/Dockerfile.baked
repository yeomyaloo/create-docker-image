# syntax=docker/dockerfile:1
# ③-B 스키마가 미리 적용된 이미지 (테스트/CI 픽스처용)
ARG BASE_IMAGE=cdi/mysql:8.4

FROM ${BASE_IMAGE} AS builder
ARG SCHEMA_DIR=schema
ARG DB_USER=app
ARG DB_NAME=app
ENV MYSQL_DATABASE=${DB_NAME} \
    MYSQL_USER=${DB_USER}
COPY --chmod=644 ${SCHEMA_DIR}/ /docker-entrypoint-initdb.d/

# /var/lib/mysql 은 VOLUME 이라 레이어에 남지 않는다 → --datadir 로 다른 경로에 초기화
RUN --mount=type=secret,id=db_password,required=true \
    export MYSQL_ROOT_PASSWORD="$(cat /run/secrets/db_password)" \
           MYSQL_PASSWORD="$(cat /run/secrets/db_password)" \
 && sed -i 's/exec "\$@"/echo "[baked] init done, skip server start"/' /usr/local/bin/docker-entrypoint.sh \
 && docker-entrypoint.sh mysqld --datadir=/var/lib/mysql-baked

FROM ${BASE_IMAGE}
COPY --from=builder --chown=mysql:mysql /var/lib/mysql-baked /var/lib/mysql-baked
CMD ["mysqld", "--datadir=/var/lib/mysql-baked"]

LABEL org.opencontainers.image.description="MySQL with schema pre-applied (for tests/CI)"
