{
  "rules": [
    {
      "rulePriority": 1,
      "description": "태그 없는(덮어써져 고아가 된) 이미지는 7일 뒤 삭제",
      "selection": {
        "tagStatus": "untagged",
        "countType": "sinceImagePushed",
        "countUnit": "days",
        "countNumber": 7
      },
      "action": { "type": "expire" }
    },
    {
      "rulePriority": 2,
      "description": "전체 이미지는 최근 30개만 유지 (스토리지 비용 상한)",
      "selection": {
        "tagStatus": "any",
        "countType": "imageCountMoreThan",
        "countNumber": 30
      },
      "action": { "type": "expire" }
    }
  ]
}
